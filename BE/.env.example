# You can copy this straight from the Neon console.
DATABASE_URL=postgresql://your_neon_role:your_neon_password@ep-example-123456-pooler.us-east-2.aws.neon.tech:5432/sla_monitoring?sslmode=require


# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:5174


# S3 bucket that keeps every raw upload, at <file_id>/<file name>.
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
